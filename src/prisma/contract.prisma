// use prisma-8

enum PipelineStatus {
  NEW_LEAD
  RESEARCHING
  CONTACTED
  QUALIFIED
  OFFER_MADE
  NEGOTIATING
  UNDER_CONTRACT
  DISPOSITION
  CLOSED
  DEAD
  NURTURE
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

model Property {
  temperature LeadTemperature?
  id             Int            @id @default(autoincrement())
  address        String
  city           String
  state          String
  zipCode        String
  county         String?
  source         String?
  askingPrice    Decimal?
  arv            Decimal?
  assignmentFee  Decimal?
  buyerPercentage Decimal?
  sellerMotivation String?
  estimatedValue Decimal?
  repairEstimate Decimal?
  offerAmount    Decimal?
  status         PipelineStatus @default(NEW_LEAD)
  nextAction     String?
  nextActionDate TimestamptzString?
  notes          String?
  contacts       PropertyContact[]
  tasks          Task[]
  activities     Activity[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model Contact {
  id         Int               @id @default(autoincrement())
  firstName  String
  lastName   String?
  phone      String?
  email      String?
  notes      String?
  properties PropertyContact[]
  tasks      Task[]
  activities Activity[]
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
}

model PropertyContact {
  id         Int      @id @default(autoincrement())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId Int
  contact    Contact  @relation(fields: [contactId], references: [id])
  contactId  Int
  role       String?
  createdAt  TimestamptzString @default(now())

  @@unique([propertyId, contactId])
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  dueDate     TimestamptzString?
  status      TaskStatus @default(PENDING)
  property    Property?  @relation(fields: [propertyId], references: [id])
  propertyId  Int?
  contact     Contact?   @relation(fields: [contactId], references: [id])
  contactId   Int?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Activity {
  id         Int       @id @default(autoincrement())
  type       String
  description String
  property   Property? @relation(fields: [propertyId], references: [id])
  propertyId Int?
  contact    Contact?  @relation(fields: [contactId], references: [id])
  contactId  Int?
  createdAt  TimestamptzString @default(now())
}

enum OfferStatus {
  DRAFT
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
}

enum AcquisitionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EarnestMoneyStatus {
  NOT_DUE
  DUE
  PAID
  WAIVED
}

model Offer {
  id Int @id @default(autoincrement())
  propertyId Int
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  contactId Int?
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  amount Decimal
  offerDate TimestamptzString?
  status OfferStatus @default(DRAFT)
  counterAmount Decimal?
  acceptedAmount Decimal?
  expirationDate TimestamptzString?
  notes String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([id, propertyId])
  @@index([propertyId, createdAt])
  @@index([contactId])
  @@index([status, expirationDate])
}

model AcquisitionContract {
  id Int @id @default(autoincrement())
  propertyId Int
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  offerId Int @unique
  offer Offer @relation(fields: [offerId, propertyId], references: [id, propertyId], onDelete: Restrict)
  contactId Int?
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  purchasePrice Decimal
  contractDate TimestamptzString?
  inspectionDeadline TimestamptzString?
  closingDeadline TimestamptzString?
  earnestMoneyAmount Decimal?
  earnestMoneyDueDate TimestamptzString?
  earnestMoneyStatus EarnestMoneyStatus @default(NOT_DUE)
  status AcquisitionStatus @default(DRAFT)
  notes String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([propertyId, status])
  @@index([contactId])
  @@index([status, closingDeadline])
  @@index([status, inspectionDeadline])
  @@index([earnestMoneyStatus, earnestMoneyDueDate], name: "acquisition_emd_due")
  @@index([propertyId], where: "\"status\" = 'ACTIVE'", unique: true, name: "one_active_acquisition_per_property")
}
